# ─────────────────────────────────────────────────────────────
# dsweb configuration. Copy to .env and fill in:
#   cp .env.example .env
# .env is gitignored — never commit secrets.
# All of these can also be set as real environment variables
# (process env wins over this file).
# ─────────────────────────────────────────────────────────────

# ── auth (required for chat / serve) ─────────────────────────
# userToken from chat.deepseek.com DevTools:
#   Application → Local Storage → https://chat.deepseek.com → userToken
DS_TOKEN=
# Optional: full Cookie request header from DevTools Network tab.
DS_COOKIE=
# Optional password login (often WAF-blocked). Prefer token/cookie.
DS_EMAIL=
DS_PASSWORD=

# ── XDG paths (override only if you need non-default locations) ─
# Defaults: ~/.config/dsweb  and  ~/.local/share/dsweb
# DS_CONFIG_DIR=
# DS_DATA_DIR=
# DS_AUTH_FILE=
# DS_COOKIE_JAR=
# DS_CACHE_DIR=

# ── local proxy (serve / cloudflared) ────────────────────────
DS_HOST=127.0.0.1
DS_PORT=8787
# Bearer key YOUR apps send to the local proxy. Change this.
# cloudflared refuses to start if this is still the default / too short.
DS_API_KEY=sk-dsweb-change-me
DS_ALLOW_UNAUTHENTICATED=false

# ── model behaviour defaults ─────────────────────────────────
DS_MODEL=deepseek-chat
DS_SYSTEM_PROMPT=
DS_DEFAULT_THINKING=false
DS_DEFAULT_SEARCH=false
DS_TIMEOUT=600

# ── cloudflared ──────────────────────────────────────────────
DS_CLOUDFLARED_AUTOINSTALL=true

# ── upstream (rarely changed) ────────────────────────────────
DS_BASE_URL=https://chat.deepseek.com
DS_CLIENT_VERSION=2.3.0
DS_IMPERSONATE=chrome131
# Optional outbound proxy, e.g. socks5://127.0.0.1:1080
DS_PROXY=
