# ─────────────────────────────────────────────────────────────
# LEGACY optional overrides. Prefer:
#   ./dsweb config set DS_API_KEY sk-…
#   ./dsweb token          # → ~/.config/dsweb/auth.json
#
# NEVER put DS_TOKEN / DS_COOKIE / DS_PASSWORD here — ignored on load.
# Process env still wins for CI one-shots: DS_TOKEN=… ./dsweb whoami
# ─────────────────────────────────────────────────────────────

# DS_HOST=127.0.0.1
# DS_PORT=8787
# DS_API_KEY=sk-dsweb-change-me
# DS_MODEL=deepseek-chat
# DS_SAVE_CHATS=false
# DS_TIMEOUT=600
